generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            String           @default("STUDENT") // STUDENT, TEACHER, HOD, COORDINATOR, REVIEWER
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  reviewerProfile   ReviewerProfile?
  createdTeams      Team[]           @relation("TeamCreator")
  teamMembers       TeamMember[]
  sentInvites       TeamInvitation[] @relation("InviteSender")
  receivedInvites   TeamInvitation[] @relation("InviteReceiver")
  guideRequests     GuideRequest[]   @relation("StudentGuideRequests")
  notifications     Notification[]
  sentEmails        EmailLog[]
  reviewAssignments ReviewAssignment[] @relation("ReviewerAssignments")
  evaluations       ReviewerEvaluation[] @relation("ReviewerEvaluations")
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber     String   @unique
  semester       Int      @default(5)
  department     String   @default("Computer Science & Engineering")
  bio            String?
  github         String?
  linkedin       String?
  skills         String   @default("[]")
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TeacherProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String
  designation      String
  areasOfExpertise String
  maxProjects      Int            @default(5)
  guideRequests    GuideRequest[]
}

model ReviewerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId          String?
  department       String   @default("Computer Science & Engineering")
  designation      String   @default("External Reviewer")
  contactNumber    String?
  areasOfExpertise String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Team {
  id          String           @id @default(uuid())
  teamName    String
  semester    Int
  creatorId   String
  creator     User             @relation("TeamCreator", fields: [creatorId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members           TeamMember[]
  invitations       TeamInvitation[]
  projects          Project[]
  reviewAssignments ReviewAssignment[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Team Member")
  status    String   @default("ACCEPTED")
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvitation {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("InviteSender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("InviteReceiver", fields: [receiverId], references: [id])
  semester    Int
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id               String         @id @default(uuid())
  teamId           String
  team             Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  semester         Int
  projectTitle     String
  problemStatement String
  description      String
  domain           String
  technologies     String         @default("[]")
  status           String         @default("PROJECT_CREATED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  guideRequests     GuideRequest[]
  reviewAssignments ReviewAssignment[]
}

model GuideRequest {
  id            String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("StudentGuideRequests", fields: [requestedById], references: [id])
  roleType      String         @default("Lead Guide")
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ReviewAssignment {
  id             String   @id @default(uuid())
  reviewerId     String
  reviewer       User     @relation("ReviewerAssignments", fields: [reviewerId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedById   String
  reviewDeadline DateTime?
  status         String   @default("PENDING")
  assignedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evaluation     ReviewerEvaluation?

  @@unique([reviewerId, projectId])
}

model ReviewerEvaluation {
  id               String           @id @default(uuid())
  assignmentId     String           @unique
  assignment       ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewer         User             @relation("ReviewerEvaluations", fields: [reviewerId], references: [id], onDelete: Cascade)
  projectId        String
  teamId           String
  criteriaMarks    String           @default("{}")
  totalMarks       Float            @default(0)
  maxTotalMarks    Float            @default(0)
  isDraft          Boolean          @default(false)
  submittedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  auditLogs        EvaluationAuditLog[]
}

model EvaluationAuditLog {
  id             String             @id @default(uuid())
  evaluationId   String
  evaluation     ReviewerEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  changedById    String
  originalMarks  String
  revisedMarks   String
  changeReason   String?
  changedAt      DateTime           @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String
  link        String?
  metadata    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EmailLog {
  id          String   @id @default(uuid())
  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  toEmail     String
  subject     String
  htmlBody    String
  textBody    String
  sentAt      DateTime @default(now())
}
